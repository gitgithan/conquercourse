{
  "name": "conquercourse",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:quick": "vitest run",
    "test:fast": "node scripts/test.mjs fast",
    "test:slow": "node scripts/test.mjs slow",
    "test:changed": "node scripts/test.mjs changed",
    "test:smoke": "node scripts/smoke.mjs",
    "film": "node scripts/film.mjs",
    "format:json": "node scripts/format-json.mjs",
    "ideal": "tsx scripts/ideal-run.ts",
    "plans": "tsx scripts/plans.ts",
    "plans:presets": "tsx scripts/preset-plans.ts",
    "deploy": "npm run build && wrangler pages deploy dist --project-name conquercourse --branch main",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name conquercourse --branch preview",
    "feedback": "node scripts/feedback-summary.mjs",
    "feedback:rows": "node scripts/feedback-rows.mjs",
    "community": "node scripts/community-review.mjs",
    "motion": "node scripts/motion.mjs",
    "perf": "node scripts/perf-check.mjs --budget",
    "thumbs": "tsx scripts/make-thumbs.ts",
    "course-meta": "tsx scripts/course-meta.ts",
    "piece-icons": "tsx scripts/make-piece-icons.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "mp4-muxer": "5.2.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright": "^1.50.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
